# Django Settings
SECRET_KEY=your_super_secret_django_key_here_minimum_50_chars_recommended
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
DOMAIN_NAME=your-domain.com
USE_TLS=True

# Database (PostgreSQL)
DATABASE_URL=postgres://selo_user:selo_password@db:5432/selo_db
DB_NAME=selo_db
DB_USER=selo_user
DB_PASSWORD=your_db_password_here

# JWT Settings
APP_JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
APP_JWT_ALG=HS256
APP_JWT_EXP_MINUTES=10080

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_app_key
KAKAO_REDIRECT_URI=https://your-domain.com/auth/kakao/callback

# URLs
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-domain.com

# Cache (Redis)
REDIS_URL=redis://redis:6379/0

# Email (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# File Storage (Optional - AWS S3)
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=ap-northeast-2